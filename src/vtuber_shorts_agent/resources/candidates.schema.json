{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "candidates 1.0",
  "type": "object",
  "description": "Use validate-selection for time containment, unique IDs and optional transcript evidence checks.",
  "required": [
    "schema_version",
    "source_media",
    "selection_strategy",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source_media": {
      "type": "string",
      "minLength": 1
    },
    "selection_strategy": {
      "type": "string",
      "minLength": 1
    },
    "duration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "start",
          "end",
          "context_start",
          "context_end",
          "evidence_segment_ids",
          "reason",
          "hook_suggestion",
          "review_status",
          "scores"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "context_start": {
            "type": "number",
            "minimum": 0
          },
          "context_end": {
            "type": "number",
            "minimum": 0
          },
          "evidence_segment_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "hook_suggestion": {
            "type": "string",
            "minLength": 1
          },
          "review_status": {
            "enum": [
              "pending",
              "approved",
              "rejected"
            ]
          },
          "scores": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "hook",
                  "understandability",
                  "personality",
                  "payoff",
                  "clipability"
                ],
                "properties": {
                  "hook": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "understandability": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "personality": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "payoff": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "clipability": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 5
                  }
                }
              }
            ]
          },
          "score_rubric_version": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "scores": {
                  "type": "object"
                }
              },
              "required": [
                "scores"
              ]
            },
            "then": {
              "required": [
                "score_rubric_version"
              ]
            }
          }
        ]
      }
    }
  }
}
